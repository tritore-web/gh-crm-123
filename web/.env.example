# CRM-123 · web — solo NOMBRES de variables. Los valores reales NUNCA se guardan en GitHub.
# Para trabajar en local copia este archivo como .env.local (git lo ignora) y rellénalo.

# Supabase › proyecto dbcrm123 › Project Settings › API › Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase › Project Settings › API Keys › clave anon / publishable (pública por diseño)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase › Project Settings › API Keys › clave service_role / secret. SECRETA: solo servidor.
# En Vercel, márcala como Sensitive. No la pegues en ninguna conversación.
SUPABASE_SERVICE_ROLE_KEY=
