        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sent: $json.sent, failed: $json.failed, errors: $json.errors }) }}",
        "options": {}
      },
      "id": "b1f81207-8aec-5be6-81b5-26944b2aad4b",
      "name": "Informar resultado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
