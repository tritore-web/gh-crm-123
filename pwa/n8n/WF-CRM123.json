              "name": "ok",
              "value": "={{ !$json.error && !!$json.id }}",
              "type": "boolean"
            },
            {
              "id": "3a76f0b2-dd1b-51d5-b6fe-a31f68fa1c8d",
              "name": "message",
              "value": "={{ $json.error ? String($json.error.message || $json.error).slice(0, 200) : '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "db77d850-0195-5369-9bb5-59e56e7ae4e4",
      "name": "Marcar resultado",
