      "typeVersion": 3.4,
      "position": [
        2860,
        110
      ]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      },
      "id": "a7a03cba-2038-5e33-bf78-ddca5b170e22",
      "name": "Esperar 1 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        3120,
        110
      ],
      "webhookId": "895ed952-3830-5cfc-a1b9-915469ba46f7"
    },
    {
      "parameters": {
        "jsCode": "// Cuenta enviados y fallidos de todos los correos. Sin lógica de negocio: solo el recuento.\nconst items = $input.all();\nconst sent = items.filter((i) => i.json.ok === true).length;\nconst failedItems = items.filter((i) => i.json.ok !== true);\nconst errors = failedItems.slice(0, 12).map((i) => ({\n  to: String(i.json.to || '-').slice(0, 200),\n  message: String(i.json.message || 'Error al enviar').slice(0, 200),\n}));\nreturn [{ json: { sent, failed: failedItems.length, errors } }];"
      },
      "id": "0d8ec472-b60f-5d10-83ee-f54a33410e49",
      "name": "Contar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "// No se pudo obtener el contenido: se informa de que no se envió nada.\nreturn [{ json: { sent: 0, failed: 0, errors: [{ to: '-', message: 'No se pudo obtener el contenido' }] } }];"
      },
      "id": "86a597bb-6367-5038-97cb-d4ef471ae469",
      "name": "Sin contenido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        260
      ]
    },
