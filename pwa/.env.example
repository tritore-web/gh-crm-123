# CRM-123 · pwa — solo NOMBRES de variables. Los valores reales NUNCA se guardan en GitHub.
# Para trabajar en local copia este archivo como .env.local (git lo ignora) y rellénalo.

# Supabase › proyecto dbcrm123 › Project Settings › API › Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase › Project Settings › API Keys › clave anon / publishable (pública por diseño)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase › Project Settings › API Keys › clave service_role / secret. SECRETA: solo servidor.
# En Vercel, márcala como Sensitive. No la pegues en ninguna conversación.
SUPABASE_SERVICE_ROLE_KEY=
# Dirección de la PWA en Vercel, sin barra final (Vercel › proyecto › Domains). Ej.: https://crm-123-pwa.vercel.app
APP_ORIGIN=

# --- Se estrenan en el Hito 4 (resumen matutino) ---
# Dos secretos distintos entre sí, de 48+ caracteres aleatorios (BUILD_PLAN §1.1). Solo en Vercel y n8n.
N8N_API_SECRET=
N8N_WEBHOOK_SECRET=
# Production URL del nodo "Disparo manual" de WF-CRM123 en n8n Cloud (existe tras importar y activar el flujo).
N8N_WEBHOOK_URL=
# Remitente de Resend en modo de prueba: CRM-123 <onboarding@resend.dev>
RESEND_FROM=
# Correo de tu cuenta de Resend (solo en modo de prueba; vacío en producción con dominio verificado).
SUMMARY_TEST_RECIPIENT=
